prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_log_globals
Description: Abseil log_globals library
URL: https://abseil.io/
Version: 20260817
Requires: absl_atomic_hook = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_hash = 20260817, absl_log_severity = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817, absl_vlog_config_internal = 20260817
Libs: -L${libdir}  -labsl_log_globals 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
