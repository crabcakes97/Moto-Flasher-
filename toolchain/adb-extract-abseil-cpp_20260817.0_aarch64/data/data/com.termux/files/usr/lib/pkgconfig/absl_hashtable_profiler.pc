prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_hashtable_profiler
Description: Abseil hashtable_profiler library
URL: https://abseil.io/
Version: 20260817
Requires: absl_profile_builder = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_strings = 20260817, absl_span = 20260817, absl_hashtablez_sampler = 20260817
Libs: -L${libdir}  -labsl_hashtable_profiler 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
